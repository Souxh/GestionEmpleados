<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gestionempleados.controlador.NovaDashboardController"
            style="-fx-background-color: #F4F7FC;">

    <!-- ENCABEZADO -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              prefHeight="80"
              style="-fx-background-color: white;
                     -fx-border-color: #E2E8F0;
                     -fx-border-width: 0 0 1 0;">

            <padding>
                <Insets top="0"
                        right="30"
                        bottom="0"
                        left="30"/>
            </padding>

            <!-- TITULO -->

            <VBox spacing="3">

                <Label text="Dashboard"
                       style="-fx-text-fill: #1E3A5F;
                              -fx-font-size: 25px;
                              -fx-font-weight: bold;"/>

                <Label text="Resumen general de empleados"
                       style="-fx-text-fill: #718096;
                              -fx-font-size: 13px;"/>

            </VBox>

            <!-- ESPACIO -->

            <HBox HBox.hgrow="ALWAYS"/>

            <!-- BOTON GESTION -->

            <Button text="Gestion"
                    prefHeight="44"
                    onAction="#abrirGestionEmpleados"
                    style="-fx-background-color: #E2E8F0;
                           -fx-text-fill: #1E3A5F;
                           -fx-background-radius: 8;
                           -fx-font-weight: bold;
                           -fx-font-size: 14px;
                           -fx-padding: 0 20 0 20;
                           -fx-cursor: hand;"/>

            <!-- BOTON NUEVO EMPLEADO -->

            <Button text="+   Nuevo empleado"
                    prefHeight="44"
                    onAction="#abrirNuevoEmpleado"
                    style="-fx-background-color: #2864E6;
                           -fx-text-fill: white;
                           -fx-background-radius: 8;
                           -fx-font-weight: bold;
                           -fx-font-size: 14px;
                           -fx-padding: 0 20 0 20;
                           -fx-cursor: hand;"/>

        </HBox>

    </top>

    <!-- CONTENIDO PRINCIPAL -->

    <center>

        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;">

            <content>

                <VBox spacing="25">

                    <padding>
                        <Insets top="30"
                                right="30"
                                bottom="30"
                                left="30"/>
                    </padding>

                    <!-- TARJETAS DE RESUMEN -->

                    <HBox spacing="18">

                        <!-- TOTAL EMPLEADOS -->

                        <VBox spacing="8"
                              HBox.hgrow="ALWAYS"
                              prefHeight="110"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-border-color: #E2E8F0;
                                     -fx-border-radius: 12;">

                            <padding>
                                <Insets top="18"
                                        right="20"
                                        bottom="18"
                                        left="20"/>
                            </padding>

                            <Label text="EMPLEADOS TOTALES"
                                   style="-fx-text-fill: #718096;
                                          -fx-font-size: 12px;
                                          -fx-font-weight: bold;"/>

                            <Label fx:id="lblTotalEmpleados"
                                   text="0"
                                   style="-fx-text-fill: #1E3A5F;
                                          -fx-font-size: 30px;
                                          -fx-font-weight: bold;"/>

                        </VBox>

                        <!-- EMPLEADOS ACTIVOS -->

                        <VBox spacing="8"
                              HBox.hgrow="ALWAYS"
                              prefHeight="110"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-border-color: #E2E8F0;
                                     -fx-border-radius: 12;">

                            <padding>
                                <Insets top="18"
                                        right="20"
                                        bottom="18"
                                        left="20"/>
                            </padding>

                            <Label text="EMPLEADOS ACTIVOS"
                                   style="-fx-text-fill: #718096;
                                          -fx-font-size: 12px;
                                          -fx-font-weight: bold;"/>

                            <Label fx:id="lblEmpleadosActivos"
                                   text="0"
                                   style="-fx-text-fill: #2F855A;
                                          -fx-font-size: 30px;
                                          -fx-font-weight: bold;"/>

                        </VBox>

                        <!-- NO ACTIVOS -->

                        <VBox spacing="8"
                              HBox.hgrow="ALWAYS"
                              prefHeight="110"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-border-color: #E2E8F0;
                                     -fx-border-radius: 12;">

                            <padding>
                                <Insets top="18"
                                        right="20"
                                        bottom="18"
                                        left="20"/>
                            </padding>

                            <Label text="NO ACTIVOS"
                                   style="-fx-text-fill: #718096;
                                          -fx-font-size: 12px;
                                          -fx-font-weight: bold;"/>

                            <Label fx:id="lblEmpleadosNoActivos"
                                   text="0"
                                   style="-fx-text-fill: #C53030;
                                          -fx-font-size: 30px;
                                          -fx-font-weight: bold;"/>

                        </VBox>

                    </HBox>

                    <!-- TABLA EMPLEADOS ACTIVOS -->

                    <VBox spacing="15"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 12;">

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <!-- ENCABEZADO TABLA -->

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="3">

                                <Label text="EMPLEADOS ACTIVOS"
                                       style="-fx-text-fill: #1E3A5F;
                                              -fx-font-size: 18px;
                                              -fx-font-weight: bold;"/>

                                <Label text="Empleados actualmente activos"
                                       style="-fx-text-fill: #718096;
                                              -fx-font-size: 12px;"/>

                            </VBox>

                            <HBox HBox.hgrow="ALWAYS"/>

                            <Button text="Modificar empleado"
                                    onAction="#modificarEmpleado"
                                    prefHeight="38"
                                    style="-fx-background-color: #E2E8F0;
                                           -fx-text-fill: #1A202C;
                                           -fx-background-radius: 8;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;"/>

                        </HBox>

                        <!-- TABLA -->

                        <TableView fx:id="tablaEmpleados"
                                   prefHeight="280"
                                   VBox.vgrow="NEVER">

                            <columns>

                                <TableColumn fx:id="colEmpleado"
                                             text="Empleado"
                                             prefWidth="190"/>

                                <TableColumn fx:id="colRol"
                                             text="Rol"
                                             prefWidth="140"/>

                                <TableColumn fx:id="colTurno"
                                             text="Turno"
                                             prefWidth="130"/>

                                <TableColumn fx:id="colEstado"
                                             text="Estado"
                                             prefWidth="100"/>

                                <TableColumn fx:id="colSalario"
                                             text="Salario"
                                             prefWidth="120"/>

                            </columns>

                        </TableView>

                    </VBox>

                    <!-- ULTIMAS ACCIONES -->

                    <VBox spacing="15"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 12;">

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <!-- TITULO -->

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="3">

                                <Label text="ULTIMAS ACCIONES"
                                       style="-fx-text-fill: #1E3A5F;
                                              -fx-font-size: 18px;
                                              -fx-font-weight: bold;"/>

                                <Label text="Actividad reciente del sistema"
                                       style="-fx-text-fill: #718096;
                                              -fx-font-size: 12px;"/>

                            </VBox>

                        </HBox>

                        <!-- TABLA HISTORIAL -->

                        <TableView fx:id="tablaAcciones"
                                   prefHeight="280">

                            <columns>

                                <TableColumn fx:id="colAccionEmpleado"
                                             text="Empleado"
                                             prefWidth="170"/>

                                <TableColumn fx:id="colAccion"
                                             text="Accion"
                                             prefWidth="170"/>

                                <TableColumn fx:id="colDescripcion"
                                             text="Descripcion"
                                             prefWidth="320"/>

                                <TableColumn fx:id="colFecha"
                                             text="Fecha"
                                             prefWidth="150"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>

