<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gestionempleados.controlador.NuevoEmpleadoController"
            prefWidth="650"
            prefHeight="720"
            style="-fx-background-color: #0B2342;">

    <!-- ENCABEZADO -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="12"
              prefHeight="64"
              style="-fx-background-color: #2864E6;">

            <padding>
                <Insets left="22"
                        right="18"/>
            </padding>

            <Label text=""
                   style="-fx-text-fill: white;
                          -fx-font-size: 22px;"/>

            <Label text="Nuevo empleado"
                   style="-fx-text-fill: white;
                          -fx-font-size: 22px;
                          -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="×"
                    onAction="#cerrarVentana"
                    prefWidth="38"
                    prefHeight="38"
                    style="-fx-background-color: white;
                           -fx-text-fill: #2864E6;
                           -fx-background-radius: 20;
                           -fx-font-size: 22px;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"/>

        </HBox>

    </top>


    <!-- CONTENIDO -->

    <center>

        <VBox spacing="18">

            <padding>
                <Insets top="22"
                        right="22"
                        bottom="15"
                        left="22"/>
            </padding>


            <!-- DATOS PERSONALES -->

            <Label text="DATOS PERSONALES"
                   style="-fx-text-fill: white;
                          -fx-font-size: 17px;
                          -fx-font-weight: bold;"/>


            <GridPane hgap="15"
                      vgap="10">

                <columnConstraints>

                    <ColumnConstraints
                            percentWidth="50"
                            hgrow="ALWAYS"/>

                    <ColumnConstraints
                            percentWidth="50"
                            hgrow="ALWAYS"/>

                </columnConstraints>


                <!-- NOMBRE -->

                <Label text="Nombre *"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-text-fill: #D7E3F4;
                              -fx-font-size: 12px;"/>

                <Label text="Apellidos *"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0"
                       style="-fx-text-fill: #D7E3F4;
                              -fx-font-size: 12px;"/>


                <TextField fx:id="txtNombre"
                           promptText="Nombre"
                           prefHeight="42"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"
                           style="-fx-background-color: #6389DE;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #D7E3F4;
                                  -fx-background-radius: 8;
                                  -fx-border-radius: 8;
                                  -fx-padding: 0 14px;"/>

                <TextField fx:id="txtApellidos"
                           promptText="Apellidos"
                           prefHeight="42"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"
                           style="-fx-background-color: #6389DE;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #D7E3F4;
                                  -fx-background-radius: 8;
                                  -fx-border-radius: 8;
                                  -fx-padding: 0 14px;"/>


                <!-- TELEFONO / EMAIL -->

                <Label text="Teléfono *"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-text-fill: #D7E3F4;
                              -fx-font-size: 12px;"/>

                <Label text="Email"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"
                       style="-fx-text-fill: #D7E3F4;
                              -fx-font-size: 12px;"/>


                <TextField fx:id="txtTelefono"
                           promptText="555-0000"
                           prefHeight="42"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="3"
                           style="-fx-background-color: #6389DE;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #D7E3F4;
                                  -fx-background-radius: 8;
                                  -fx-border-radius: 8;
                                  -fx-padding: 0 14px;"/>

                <TextField fx:id="txtEmail"
                           promptText="correo@ejemplo.com"
                           prefHeight="42"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"
                           style="-fx-background-color: #6389DE;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #D7E3F4;
                                  -fx-background-radius: 8;
                                  -fx-border-radius: 8;
                                  -fx-padding: 0 14px;"/>


                <!-- DIRECCION -->

                <Label text="Dirección"
                       GridPane.columnIndex="0"
                       GridPane.columnSpan="2"
                       GridPane.rowIndex="4"
                       style="-fx-text-fill: #D7E3F4;
                              -fx-font-size: 12px;"/>


                <TextField fx:id="txtDireccion"
                           promptText="Dirección"
                           prefHeight="42"
                           GridPane.columnIndex="0"
                           GridPane.columnSpan="2"
                           GridPane.rowIndex="5"
                           style="-fx-background-color: #6389DE;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #D7E3F4;
                                  -fx-background-radius: 8;
                                  -fx-border-radius: 8;
                                  -fx-padding: 0 14px;"/>

            </GridPane>


            <!-- SEPARADOR -->

            <Region prefHeight="2"
                    maxHeight="2"
                    style="-fx-background-color: #2864E6;"/>


            <!-- INFORMACION LABORAL -->

            <Label text="INFORMACIÓN LABORAL"
                   style="-fx-text-fill: white;
                          -fx-font-size: 17px;
                          -fx-font-weight: bold;"/>


            <GridPane hgap="15"
                      vgap="10">

                <columnConstraints>

                    <ColumnConstraints
                            percentWidth="50"
                            hgrow="ALWAYS"/>

                    <ColumnConstraints
                            percentWidth="50"
                            hgrow="ALWAYS"/>

                </columnConstraints>


                <!-- FECHA -->

                <Label text="Fecha de ingreso *"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-text-fill: #D7E3F4;
                              -fx-font-size: 12px;"/>

                <Label text="Salario *"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0"
                       style="-fx-text-fill: #D7E3F4;
                              -fx-font-size: 12px;"/>


                <DatePicker fx:id="fechaIngreso"
                            prefHeight="42"
                            prefWidth="250"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"
                            style="-fx-background-color: #6389DE;
                                   -fx-background-radius: 8;
                                   -fx-border-radius: 8;"/>

                <TextField fx:id="txtSalario"
                           promptText="Ej. 5500"
                           prefHeight="42"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"
                           style="-fx-background-color: #6389DE;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #D7E3F4;
                                  -fx-background-radius: 8;
                                  -fx-border-radius: 8;
                                  -fx-padding: 0 14px;"/>


                <!-- ROL -->

                <Label text="Rol *"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-text-fill: #D7E3F4;
                              -fx-font-size: 12px;"/>

                <Label text="Turno *"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"
                       style="-fx-text-fill: #D7E3F4;
                              -fx-font-size: 12px;"/>


                <ComboBox fx:id="cmbRol"
                          promptText="Selecciona un rol"
                          prefHeight="42"
                          maxWidth="Infinity"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="3"
                          style="-fx-background-color: #6389DE;
                                 -fx-background-radius: 8;
                                 -fx-border-radius: 8;"/>

                <ComboBox fx:id="cmbTurno"
                          promptText="Selecciona un turno"
                          prefHeight="42"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"
                          style="-fx-background-color: #6389DE;
                                 -fx-background-radius: 8;
                                 -fx-border-radius: 8;"/>


                <!-- ESTADO -->

                <Label text="Estado *"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"
                       style="-fx-text-fill: #D7E3F4;
                              -fx-font-size: 12px;"/>


                <ComboBox fx:id="cmbEstado"
                          promptText="Selecciona un estado"
                          prefHeight="42"
                          maxWidth="Infinity"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="5"
                          style="-fx-background-color: #6389DE;
                                 -fx-background-radius: 8;
                                 -fx-border-radius: 8;"/>

            </GridPane>

        </VBox>

    </center>


    <!-- BOTONES -->

    <bottom>

        <VBox spacing="12">

            <padding>
                <Insets top="5"
                        right="22"
                        bottom="22"
                        left="22"/>
            </padding>

            <Region prefHeight="1"
                    maxHeight="1"
                    style="-fx-background-color: #2864E6;"/>

            <HBox alignment="CENTER_RIGHT"
                  spacing="10">

                <Button text="Cancelar"
                        onAction="#cerrarVentana"
                        prefWidth="105"
                        prefHeight="42"
                        style="-fx-background-color: #405F9D;
                               -fx-text-fill: #D7E3F4;
                               -fx-background-radius: 8;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>

                <Button text="Registrar empleado"
                        onAction="#registrarEmpleado"
                        prefWidth="165"
                        prefHeight="42"
                        style="-fx-background-color: #2864E6;
                               -fx-text-fill: white;
                               -fx-background-radius: 8;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>

            </HBox>

        </VBox>

    </bottom>

</BorderPane>